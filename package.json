{
  "name": "kotooborona",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vitest run --config vitest.balance.config.ts",
    "sfx": "node scripts/sfx.mjs",
    "smoke": "node -e \"fs.rmSync('screenshots', { recursive: true, force: true })\" && playwright test",
    "perf": "playwright test -c playwright.perf.config.ts",
    "pack": "vite build && node scripts/pack.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
